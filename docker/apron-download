#!/bin/bash
# apron-download <repo_id> <local_dir> — fetch weights with the HF token (F7).
#
# The only process that reads /run/apron/hf_token.  The token is passed to
# huggingface_hub as an argument inside this process and is never exported,
# so nothing started afterwards (vLLM) inherits it.
set -euo pipefail
REPO="$1"
DEST="$2"
mkdir -p "$DEST"
/opt/venv/bin/python3 - "$REPO" "$DEST" <<'PY'
import pathlib
import sys

from huggingface_hub import snapshot_download

repo, dest = sys.argv[1], sys.argv[2]
token_file = pathlib.Path("/run/apron/hf_token")
token = token_file.read_text().strip() if token_file.exists() else None
# Native duplicates vLLM does not load (see vllm_engine.DOWNLOAD_IGNORE).
ignore = ["original/*", "consolidated*", "*.pth", "*.pt", "*.gguf"]
snapshot_download(repo_id=repo, local_dir=dest, token=token or None, ignore_patterns=ignore)
print(f"apron-download: {repo} -> {dest}")
PY
