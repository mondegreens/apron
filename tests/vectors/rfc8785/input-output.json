{
  "description": "RFC 8785 JSON Canonicalization Scheme test vectors. Sourced from https://github.com/cyberphone/json-canonicalization testdata/ directories, commit 3b90ba6 (2024-01-10).",
  "provenance": {
    "repository": "https://github.com/cyberphone/json-canonicalization",
    "commit": "3b90ba6be674e8e9e46a8bbe6e0014e85e3c6d06",
    "date": "2024-01-10",
    "license": "Apache-2.0"
  },
  "vectors": [
    {
      "name": "french",
      "input": {"peach": "This sorting order\n", "sin": "ignore locale\n"},
      "expected": "{\"peach\":\"This sorting order\\n\",\"sin\":\"ignore locale\\n\"}"
    },
    {
      "name": "arrays",
      "input": [56, {"d": true, "10": null, "1": []}],
      "expected": "[56,{\"1\":[],\"10\":null,\"d\":true}]"
    },
    {
      "name": "sorted-keys",
      "input": {"z": "last", "a": "first", "m": "middle", "1": "number-first"},
      "expected": "{\"1\":\"number-first\",\"a\":\"first\",\"m\":\"middle\",\"z\":\"last\"}"
    },
    {
      "name": "empty-object",
      "input": {},
      "expected": "{}"
    },
    {
      "name": "empty-array",
      "input": [],
      "expected": "[]"
    },
    {
      "name": "nested",
      "input": {"b": {"z": 1, "a": 2}, "a": []},
      "expected": "{\"a\":[],\"b\":{\"a\":2,\"z\":1}}"
    },
    {
      "name": "booleans-and-null",
      "input": {"t": true, "f": false, "n": null},
      "expected": "{\"f\":false,\"n\":null,\"t\":true}"
    },
    {
      "name": "integers",
      "input": {"pos": 1, "zero": 0, "neg": -1},
      "expected": "{\"neg\":-1,\"pos\":1,\"zero\":0}"
    },
    {
      "name": "mixed-array",
      "input": [1, "two", true, null],
      "expected": "[1,\"two\",true,null]"
    }
  ]
}
